{
  "name": "fast-elementplus-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @fast-elementplus/playground dev",
    "dev:docs": "pnpm --filter @fast-elementplus/docs dev",
    "build": "pnpm -r --if-present build",
    "build:components": "pnpm --filter fast-elementplus-components build",
    "build:playground": "pnpm --filter @fast-elementplus/playground build",
    "build:docs": "pnpm --filter @fast-elementplus/docs build",
    "preview": "pnpm --filter @fast-elementplus/playground preview",
    "preview:docs": "pnpm --filter @fast-elementplus/docs preview",
    "type-check": "pnpm build:components && pnpm -r --if-present type-check",
    "lint": "eslint packages apps --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "lint:check": "eslint packages apps --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --ignore-path .gitignore",
    "format": "prettier --write \"packages/**/*.{ts,tsx,vue,js,json,scss,md}\" \"apps/**/*.{ts,tsx,vue,js,json,scss,md}\" \"*.{json,yaml,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.3.3",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "eslint": "^8.49.0",
    "eslint-plugin-vue": "^9.17.0",
    "prettier": "^3.0.3",
    "typescript": "^5.4.3"
  }
}